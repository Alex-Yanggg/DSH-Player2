{
  "name": "dsh-player2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ledger:export": "node scripts/ledger-export.mjs",
    "accept": "npm run build && npm run typecheck && npm test && dotnet test player2-core.tests/DSHPlayer2.Core.Tests.csproj --configuration Release"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
