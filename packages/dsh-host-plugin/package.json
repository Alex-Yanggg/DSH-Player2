{
  "name": "@dsh-player2/dsh-host-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["dist", "cordis.patch.yml"],
  "scripts": {
    "prebuild": "node -e \"for (const path of ['dist', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "build": "tsc --build tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@dsh-player2/contracts": "file:../contracts",
    "@dsh-player2/dsh-companion-plugin": "file:../dsh-companion-plugin",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "24.13.3"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1" }
}
