<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>DSHPlayer2.Stardew</RootNamespace>
    <AssemblyName>DSHPlayer2.Stardew</AssemblyName>
    <Version>0.2.0</Version>
    <Nullable>enable</Nullable>
    <ModFolderName>DSHPlayer2</ModFolderName>
    <EnableModZip>true</EnableModZip>
    <EnableHarmony>true</EnableHarmony>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\player2-core\DSHPlayer2.Core.csproj" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official persona packs (P2-0017) ship in the mod folder; players add their own beside them. -->
    <None Include="..\personas\**\persona.json" Link="personas\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
